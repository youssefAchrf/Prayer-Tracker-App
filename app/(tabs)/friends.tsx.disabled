import React, { useState } from 'react';
import {
  View,
  Text,
  StyleSheet,
  ScrollView,
  SafeAreaView,
  TouchableOpacity,
  TextInput,
  Platform,
  StatusBar,
  ActivityIndicator,
  Alert,
} from 'react-native';
import {
  Plus,
  Search,
  UserPlus,
  Check,
  X,
  Eye,
  EyeOff,
  Users,
  User as UserIcon,
  Mail,
  ChevronRight
} from 'lucide-react-native';
import { useUser } from '@/contexts/UserContext';
import { Friend } from '@/types/prayer';
import { supabase } from '@/lib/supabase';
import { router } from 'expo-router';

export default function FriendsScreen() {
  const { user, friends, updateFriendStatus, toggleFriendPrayerAccess } = useUser();
  const [searchQuery, setSearchQuery] = useState('');
  const [showAddFriend, setShowAddFriend] = useState(false);
  const [newFriendEmail, setNewFriendEmail] = useState('');
  const [loading, setLoading] = useState(false);

  const acceptedFriends = friends.filter(f => f.status === 'accepted');
  const pendingFriends = friends.filter(f => f.status === 'pending');

  // --- FIX #1: THIS FUNCTION IS NOW CORRECT ---
  // It calls the Supabase database function instead of creating a fake ID.
  const handleAddFriend = async () => {
    console.log("--- I AM USING THE NEW, CORRECT ADD FRIEND FUNCTION ---");

    if (newFriendEmail.trim() && !loading) {
      setLoading(true);

      const { error } = await supabase.rpc('create_friend_request', {
        friend_email: newFriendEmail.trim().toLowerCase(),
      });

      setLoading(false);

      if (error) {
        console.error('Error sending friend request:', error);
        Alert.alert('Error', 'Could not send friend request. Please check the email and try again.');
      } else {
        Alert.alert('Success', 'Friend request sent!');
        setNewFriendEmail('');
        setShowAddFriend(false);
      }
    }
  };

  const filteredFriends = acceptedFriends.filter(friend =>
    friend.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
    (friend.email && friend.email.toLowerCase().includes(searchQuery.toLowerCase()))
  );

  const handleFriendPress = (friend: Friend) => {
    router.push(`/friends/${friend.id}`);
  };

  return (
    <SafeAreaView style={styles.container}>
      <View style={styles.header}>
        <Text style={styles.headerTitle}>Friends</Text>
        <TouchableOpacity style={styles.addButton} onPress={() => setShowAddFriend(true)}>
          <Plus size={20} color="#ffffff" />
        </TouchableOpacity>
      </View>

      <ScrollView style={styles.content} showsVerticalScrollIndicator={false}>
        {/* Search */}
        <View style={styles.searchContainer}>
          <Search size={20} color="#6b7280" />
          <TextInput
            style={styles.searchInput}
            placeholder="Search friends..."
            value={searchQuery}
            onChangeText={setSearchQuery}
            placeholderTextColor="#9ca3af"
          />
        </View>

        {/* Add Friend Modal */}
        {showAddFriend && (
          <View style={styles.addFriendCard}>
            <Text style={styles.cardTitle}>Add New Friend</Text>
            <Text style={styles.cardDescription}>
              Enter your friend's email address to send them a friend request
            </Text>
            <View style={styles.inputContainer}>
              <Mail size={20} color="#6b7280" />
              <TextInput
                style={styles.textInput}
                placeholder="friend@example.com"
                value={newFriendEmail}
                onChangeText={setNewFriendEmail}
                placeholderTextColor="#9ca3af"
                keyboardType="email-address"
                autoCapitalize="none"
              />
            </View>
            <View style={styles.buttonRow}>
              <TouchableOpacity style={[styles.button, styles.cancelButton]} onPress={() => setShowAddFriend(false)}>
                <Text style={styles.cancelButtonText}>Cancel</Text>
              </TouchableOpacity>
              <TouchableOpacity
                style={[styles.button, styles.addFriendButton, loading && styles.disabledButton]}
                onPress={handleAddFriend}
                disabled={loading}
              >
                {loading ? (
                  <ActivityIndicator size="small" color="#ffffff" />
                ) : (
                  <>
                    <UserPlus size={16} color="#ffffff" />
                    <Text style={styles.addButtonText}>Send Request</Text>
                  </>
                )}
              </TouchableOpacity>
            </View>
          </View>
        )}

        {/* --- FIX #2: THIS SECTION IS NOW CORRECT --- */}
        {/* It shows the "Accept/Reject" buttons to the correct person. */}
        {pendingFriends.length > 0 && (
          <View style={styles.section}>
            <Text style={styles.sectionTitle}>Pending Requests</Text>
            {pendingFriends.map((friendRequest) => {
              if (user && friendRequest.addressee_id === user.id) {
                return (
                  <View key={friendRequest.id} style={styles.friendCard}>
                    <View style={styles.friendInfo}>
                      <View style={styles.avatar}>
                        <UserIcon size={20} color="#6b7280" />
                      </View>
                      <View style={styles.friendDetails}>
                        <Text style={styles.friendName}>{friendRequest.name}</Text>
                        <Text style={styles.friendEmail}>{friendRequest.email}</Text>
                      </View>
                    </View>
                    <View style={styles.pendingActions}>
                      <TouchableOpacity
                        style={styles.acceptButton}
                        onPress={() => updateFriendStatus(friendRequest.id, 'accepted')}
                      >
                        <Check size={16} color="#ffffff" />
                      </TouchableOpacity>
                      <TouchableOpacity
                        style={styles.rejectButton}
                        onPress={() => updateFriendStatus(friendRequest.id, 'blocked')}
                      >
                        <X size={16} color="#ffffff" />
                      </TouchableOpacity>
                    </View>
                  </View>
                );
              }
              else if (user && friendRequest.requester_id === user.id) {
                return (
                  <View key={friendRequest.id} style={styles.friendCard}>
                    <View style={styles.friendInfo}>
                      <View style={styles.avatar}>
                        <UserIcon size={20} color="#6b7280" />
                      </View>
                      <View style={styles.friendDetails}>
                        <Text style={styles.friendName}>{friendRequest.name}</Text>
                        <Text style={styles.friendEmail}>{friendRequest.email}</Text>
                      </View>
                    </View>
                    <Text style={styles.pendingText}>Request Sent</Text>
                  </View>
                );
              }
              return null;
            })}
          </View>
        )}

        {/* Friends List */}
        <View style={styles.section}>
          <Text style={styles.sectionTitle}>My Friends ({acceptedFriends.length})</Text>
          {filteredFriends.length === 0 ? (
            <View style={styles.emptyState}>
              <Users size={48} color="#d1d5db" />
              <Text style={styles.emptyStateTitle}>No friends yet</Text>
              <Text style={styles.emptyStateText}>
                Add friends by their email to stay motivated together.
              </Text>
            </View>
          ) : (
            filteredFriends.map((friend) => (
              <TouchableOpacity
                key={friend.id}
                style={styles.friendCard}
                onPress={() => handleFriendPress(friend)}
                activeOpacity={0.7}
              >
                <View style={styles.friendInfo}>
                  <View style={styles.avatar}>
                    <UserIcon size={20} color="#6b7280" />
                  </View>
                  <View style={styles.friendDetails}>
                    <Text style={styles.friendName}>{friend.name}</Text>
                    <Text style={styles.friendEmail}>{friend.email}</Text>
                  </View>
                </View>
                <View style={styles.friendActions}>
                  <TouchableOpacity
                    style={styles.viewToggle}
                    onPress={(e) => {
                      e.stopPropagation();
                      toggleFriendPrayerAccess(friend.id);
                    }}
                  >
                    {friend.canViewPrayers ? (
                      <Eye size={20} color="#059669" />
                    ) : (
                      <EyeOff size={20} color="#6b7280" />
                    )}
                  </TouchableOpacity>
                  <ChevronRight size={16} color="#6b7280" />
                </View>
              </TouchableOpacity>
            ))
          )}
        </View>
      </ScrollView>
    </SafeAreaView>
  );
}

